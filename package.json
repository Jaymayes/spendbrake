{
  "name": "spendbrake",
  "version": "0.1.0",
  "description": "Enforcement gates for running LLM agents in production: spend ceiling, reservation, loop breaker, human release, disclosure guards, retraction.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema.sql",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "governance",
    "finops",
    "human-in-the-loop",
    "cloudflare-workers",
    "llm-cost-control",
    "spending-limit",
    "kill-switch"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "author": "Jamarr Mayes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaymayes/spendbrake.git"
  },
  "homepage": "https://github.com/Jaymayes/spendbrake#readme",
  "bugs": {
    "url": "https://github.com/Jaymayes/spendbrake/issues"
  }
}
